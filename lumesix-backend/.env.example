# Lumesix Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/lumesix
REDIS_URL=redis://localhost:6379

# RevenueCat API Configuration
REVENUECAT_API_KEY=your_revenuecat_api_key_here
REVENUECAT_BASE_URL=https://api.revenuecat.com/v1

# OneSignal Configuration (for notifications)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# App Store Connect API (optional)
APP_STORE_CONNECT_KEY_ID=your_key_id
APP_STORE_CONNECT_ISSUER_ID=your_issuer_id
APP_STORE_CONNECT_PRIVATE_KEY_PATH=./keys/AuthKey.p8

# Google Play Console API (optional)
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=./keys/google-play-service-account.json

# Analytics & Monitoring
ANALYTICS_ENABLED=true
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

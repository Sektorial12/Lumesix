# Lumesix - RevenueCat Configuration
# Copy this file to .env and add your actual API keys

# RevenueCat API Keys
# Get these from https://app.revenuecat.com → Project Settings → API Keys
REVENUECAT_IOS_API_KEY=appl_your_ios_api_key_here
REVENUECAT_ANDROID_API_KEY=goog_your_android_api_key_here
REVENUECAT_APP_ID=lumesix-app

# Backend API Configuration
BACKEND_API_URL=http://localhost:3000/api/v1
BACKEND_API_TIMEOUT=10000

# App Configuration  
APP_ENV=development
DEBUG_MODE=true

# Analytics Configuration
ENABLE_ANALYTICS=true
ANALYTICS_ENDPOINT=https://api.lumesix.com/analytics

# Feature Flags
FEATURE_REAL_TIME_ANALYTICS=true
FEATURE_WEBHOOKS=true
FEATURE_PUSH_NOTIFICATIONS=true

# Development Settings
LOG_LEVEL=info
MOCK_DATA_ENABLED=true
